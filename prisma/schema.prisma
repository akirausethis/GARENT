// ==============================================================================
// GARENT (Garage Rental) — Prisma Schema for Supabase PostgreSQL
// Relational Database Model for LSP Pemrogram Certification
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// Model 1: User (Tabel 'users')
// ------------------------------------------------------------------------------
model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String             @map("password_hash")
  role               String             @default("penyewa") // 'admin' | 'penyewa'
  nik                String?            @unique
  fullName           String             @map("full_name")
  phoneNumber        String             @map("phone_number")
  verificationStatus String             @default("pending") @map("verification_status") // 'pending' | 'approved' | 'rejected'
  createdAt          DateTime           @default(now()) @map("created_at")

  rentals            Rental[]
  rentalExtensions   RentalExtension[]

  @@map("users")
}

// ------------------------------------------------------------------------------
// Model 2: Garage (Tabel 'garages')
// ------------------------------------------------------------------------------
model Garage {
  id             String          @id @default(uuid())
  code           String          @unique // S001..S999, C001..C999, E001..E999
  type           String          // 'sepeda' | 'mobil' | 'mobil_listrik'
  sequenceNumber Int             @map("sequence_number") // 1..999
  dailyPrice     Decimal         @db.Decimal(12, 2) @map("daily_price")
  kwhPrice       Decimal?        @db.Decimal(10, 2) @map("kwh_price")
  status         String          @default("available") @map("status") // 'available' | 'used'
  createdAt      DateTime        @default(now()) @map("created_at")

  rentals        Rental[]

  @@unique([type, sequenceNumber])
  @@map("garages")
}

// ------------------------------------------------------------------------------
// Model 3: Rental (Tabel 'rentals')
// ------------------------------------------------------------------------------
model Rental {
  id                 String             @id @default(uuid())
  userId             String             @map("user_id")
  garageId           String             @map("garage_id")
  vehicleType        String             @map("vehicle_type") // 'sepeda' | 'sepeda_motor' | 'mobil' | 'mobil_listrik'
  plateNumber        String?            @map("plate_number")
  vehicleBrandType   String             @map("vehicle_brand_type")
  maxBatteryKwh      Decimal?           @db.Decimal(6, 2) @map("max_battery_kwh")
  currentBatteryKwh  Decimal?           @db.Decimal(6, 2) @map("current_battery_kwh")
  rentalType         String             @map("rental_type") // 'harian' | 'bulanan'
  durationDays       Int                @map("duration_days")
  startDate          DateTime           @db.Date @map("start_date")
  endDate            DateTime           @db.Date @map("end_date")
  rentalCost         Decimal            @db.Decimal(12, 2) @map("rental_cost")
  electricityCost    Decimal            @default(0) @db.Decimal(12, 2) @map("electricity_cost")
  totalCost          Decimal            @db.Decimal(12, 2) @map("total_cost")
  paymentProofUrl    String?            @map("payment_proof_url")
  status             String             @default("active") @map("status") // 'active' | 'completed' | 'extended'
  createdAt          DateTime           @default(now()) @map("created_at")

  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  garage             Garage             @relation(fields: [garageId], references: [id], onDelete: Restrict)
  extensions         RentalExtension[]

  @@map("rentals")
}

// ------------------------------------------------------------------------------
// Model 4: RentalExtension (Tabel 'rental_extensions')
// ------------------------------------------------------------------------------
model RentalExtension {
  id                 String             @id @default(uuid())
  rentalId           String             @map("rental_id")
  adminId            String             @map("admin_id")
  oldEndDate         DateTime           @db.Date @map("old_end_date")
  newEndDate         DateTime           @db.Date @map("new_end_date")
  additionalDays     Int                @map("additional_days")
  additionalCost     Decimal            @db.Decimal(12, 2) @map("additional_cost")
  paymentProofUrl    String             @map("payment_proof_url")
  createdAt          DateTime           @default(now()) @map("created_at")

  rental             Rental             @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  admin              User               @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@map("rental_extensions")
}
